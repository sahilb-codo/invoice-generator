# Copy this file to .env and fill in your own values.
# Never commit real credentials.

# Resend email delivery (server-side only) — https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"

# Sender shown to customers. The domain must be verified in Resend
# (https://resend.com/domains). For quick tests without a domain use
# "onboarding@resend.dev" — Resend then only delivers to your own account address.
EMAIL_FROM="Your Business <billing@example.com>"
